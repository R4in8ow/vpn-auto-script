# ============================================================================
# vpn-auto-script — example environment file
#
#   cp .env.example .env
#   # edit .env with YOUR OWN values (never commit .env — it is gitignored)
#   sudo bash install.sh                 # interactive for anything missing
#   sudo bash install.sh --non-interactive   # fail instead of prompting
#
# Everything here is placeholders. No real domains, IPs or passwords.
# ============================================================================

# --- Domains & contact --------------------------------------------------------
PANEL_DOMAIN=panel.example.com
CDN_DOMAIN=cdn.example.com
SUB_DOMAIN=panel.example.com        # subscription links host (default: panel domain)
LE_EMAIL=admin@example.com          # Let's Encrypt renewal notices

# --- Ports --------------------------------------------------------------------
PANEL_PORT=2053
SUB_PORT=2096
REALITY_PORT=36878
WS_PORT=8443
GRPC_PORT=2087
XHTTP_PORT=2089
HY2_PORT=40797
SS_PORT=58023
TUIC_PORT=443

# --- Reality camouflage -------------------------------------------------------
REALITY_DEST=web.dev:443
REALITY_SNI=web.dev

# --- Panel admin (REQUIRED — leave empty here, set in your own .env) ----------
ADMIN_USER=admin
ADMIN_PASS=

# --- Layout -------------------------------------------------------------------
# yes = nginx stream SNI router owns public 443 (recommended, production layout)
# no  = classic layout, nginx HTTPS directly on public 443
SNI_ROUTING=yes

# --- Optional extras ----------------------------------------------------------
INSTALL_FAIL2BAN=no        # yes/no — SSH brute-force protection
UFW_DEFAULT_DENY=no        # yes/no — set UFW default policy to deny incoming
